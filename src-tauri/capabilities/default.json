{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-app-info",
    "allow-load-app-data",
    "allow-save-app-data",
    "allow-minimize-to-tray",
    "allow-notify-overtime",
    "allow-export-json",
    "allow-import-json",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
